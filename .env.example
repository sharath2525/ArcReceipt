# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# .env.example is safe to commit — it has no real values.

# ── Required ────────────────────────────────────────────────────────────────

# The wallet address allowed to access the merchant workspace.
# To allow multiple wallets, use a comma-separated list:
#   VITE_MERCHANT_ADDRESS=0xFirst...,0xSecond...
VITE_MERCHANT_ADDRESS=0xYourMerchantWalletAddress

# ── Optional ────────────────────────────────────────────────────────────────

# Base URL of the deployed app (used for generating payment links/QR codes).
# Leave empty in local dev — the app uses window.location automatically.
VITE_APP_ORIGIN=https://your-app.vercel.app
